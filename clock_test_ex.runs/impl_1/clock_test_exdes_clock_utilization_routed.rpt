# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y423 [get_ports DRP_CLK_IN_N]
set_property LOC IOB_X1Y424 [get_ports DRP_CLK_IN_P]

# Clock net "idelay_ref200" driven by instance "u_idelay_ref_bufg" located at site "BUFGCTRL_X0Y21"
#startgroup
create_pblock {CLKAG_idelay_ref200}
add_cells_to_pblock [get_pblocks  {CLKAG_idelay_ref200}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="idelay_ref200"}]]]
resize_pblock [get_pblocks {CLKAG_idelay_ref200}] -add {CLOCKREGION_X0Y9:CLOCKREGION_X0Y9}
#endgroup

# Clock net "drpclk_in_i" driven by instance "DRP_CLK_BUFG" located at site "BUFGCTRL_X0Y16"
#startgroup
